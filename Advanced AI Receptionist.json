    {
      "parameters": {
        "sendTo": "={{ $fromAI('To', ``, 'string') }}",
        "subject": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Subject', ``, 'string') }}",
        "message": "=<!DOCTYPE html>\n<html>\n<head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"></head>\n<body style=\"margin:0;padding:0;background:#f4f7f4;font-family:'Helvetica Neue',Arial,sans-serif;\">\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f4f7f4;padding:32px 16px;\">\n  <tr><td align=\"center\">\n    <table width=\"560\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #d3e8d3;\">\n\n      <!-- Header -->\n      <tr>\n        <td style=\"background:#0F6E56;padding:32px 32px 24px;text-align:center;\">\n          <p style=\"color:#9FE1CB;font-size:12px;letter-spacing:0.1em;text-transform:uppercase;margin:0 0 8px;\">Dhaka Dental Service</p>\n          <h1 style=\"color:#ffffff;font-size:26px;font-weight:400;font-style:italic;margin:0;font-family:Georgia,serif;\">{{ $fromAI('email_heading', '', 'string') }}</h1>\n        </td>\n      </tr>\n\n      <!-- Greeting -->\n      <tr>\n        <td style=\"padding:28px 32px 0;\">\n          <p style=\"font-size:15px;color:#444;line-height:1.7;margin:0;\">\n            Dear <strong style=\"color:#0F6E56;\">{{ $fromAI('Name', '', 'string') }}</strong>,<br>\n            Your appointment has been successfully {{ $fromAI('action_status', '', 'string') }}.\n          </p>\n        </td>\n      </tr>\n\n      <!-- Appointment Details Box -->\n      <tr>\n        <td style=\"padding:20px 32px;\">\n          <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#E1F5EE;border-radius:10px;border-left:4px solid #0F6E56;padding:20px 24px;\">\n            <tr><td colspan=\"2\" style=\"padding-bottom:12px;\">\n              <p style=\"font-size:11px;color:#0F6E56;text-transform:uppercase;letter-spacing:0.1em;margin:0;font-weight:600;\">📋 Appointment Details</p>\n            </td></tr>\n            <tr>\n              <td style=\"font-size:13px;color:#085041;padding:5px 0;width:40%;\">📅 Date</td>\n              <td style=\"font-size:14px;color:#04342C;font-weight:600;padding:5px 0;\">{{ $fromAI('appointment_date', '', 'string') }}</td>\n            </tr>\n            <tr>\n              <td style=\"font-size:13px;color:#085041;padding:5px 0;\">🕐 Time</td>\n              <td style=\"font-size:14px;color:#04342C;font-weight:600;padding:5px 0;\">{{ $fromAI('appointment_time', '', 'string') }}</td>\n            </tr>\n            <tr>\n              <td style=\"font-size:13px;color:#085041;padding:5px 0;\">🦷 Purpose</td>\n              <td style=\"font-size:14px;color:#04342C;font-weight:600;padding:5px 0;\">{{ $fromAI('purpose', '', 'string') }}</td>\n            </tr>\n            <tr>\n              <td style=\"font-size:13px;color:#085041;padding:5px 0;\">📞 Phone</td>\n              <td style=\"font-size:14px;color:#04342C;font-weight:600;padding:5px 0;\">{{ $fromAI('phone_number', '', 'string') }}</td>\n            </tr>\n          </table>\n        </td>\n      </tr>\n\n      <!-- Location -->\n      <tr>\n        <td style=\"padding:0 32px 20px;\">\n          <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f9f9f7;border-radius:8px;padding:16px 20px;\">\n            <tr>\n              <td style=\"font-size:13px;color:#555;line-height:1.7;\">\n                📍 <strong style=\"color:#333;\">Gulshan Dental Service</strong><br>\n                Gulshan-1, Dhaka 1212<br>\n                📞 +880 1900-000000\n              </td>\n            </tr>\n          </table>\n        </td>\n      </tr>\n\n      <!-- Reminder -->\n      <tr>\n        <td style=\"padding:0 32px 28px;\">\n          <p style=\"font-size:13px;color:#777;line-height:1.7;margin:0;border-top:1px solid #e8ede8;padding-top:16px;\">\n            ⏰ Please arrive <strong>5 minutes early</strong>.<br>\n            Need to reschedule? Contact us at least <strong>24 hours before</strong> your appointment.\n          </p>\n        </td>\n      </tr>\n\n      <!-- Footer -->\n      <tr>\n        <td style=\"background:#f4f7f4;padding:16px 32px;text-align:center;border-top:1px solid #e0e8e0;\">\n          <p style=\"font-size:12px;color:#999;margin:0;\">© 2025 Gulshan Dental Service · Gulshan, Dhaka</p>\n          <p style=\"font-size:12px;color:#bbb;margin:4px 0 0;\">This is an automated confirmation. Please do not reply to this email.</p>\n        </td>\n      </tr>\n\n    </table>\n  </td></tr>\n</table>\n</body>\n</html>",
        "options": {}
      },
